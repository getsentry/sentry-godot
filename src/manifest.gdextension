[configuration]

entry_symbol = "sentry_gdextension_init"
compatibility_minimum = "{compatibility_minimum}"

[libraries]

macos = "res://addons/sentry/bin/macos/libsentry.macos.dylib"

windows.x86_64 = "res://addons/sentry/bin/windows/x86_64/crashpad/libsentry.windows.x86_64.dll"
windows.x86_64.sentry_crash_backend_crashpad = "res://addons/sentry/bin/windows/x86_64/crashpad/libsentry.windows.x86_64.dll"
windows.x86_64.sentry_crash_backend_native = "res://addons/sentry/bin/windows/x86_64/native/libsentry.windows.x86_64.dll"
windows.x86_32 = "res://addons/sentry/bin/windows/x86_32/crashpad/libsentry.windows.x86_32.dll"
windows.x86_32.sentry_crash_backend_crashpad = "res://addons/sentry/bin/windows/x86_32/crashpad/libsentry.windows.x86_32.dll"
windows.x86_32.sentry_crash_backend_native = "res://addons/sentry/bin/windows/x86_32/native/libsentry.windows.x86_32.dll"
windows.arm64 = "res://addons/sentry/bin/windows/arm64/crashpad/libsentry.windows.arm64.dll"
windows.arm64.sentry_crash_backend_crashpad = "res://addons/sentry/bin/windows/arm64/crashpad/libsentry.windows.arm64.dll"
windows.arm64.sentry_crash_backend_native = "res://addons/sentry/bin/windows/arm64/native/libsentry.windows.arm64.dll"

linux.x86_64 = "res://addons/sentry/bin/linux/x86_64/crashpad/libsentry.linux.x86_64.so"
linux.x86_64.sentry_crash_backend_crashpad = "res://addons/sentry/bin/linux/x86_64/crashpad/libsentry.linux.x86_64.so"
linux.x86_64.sentry_crash_backend_native = "res://addons/sentry/bin/linux/x86_64/native/libsentry.linux.x86_64.so"
linux.x86_32 = "res://addons/sentry/bin/linux/x86_32/crashpad/libsentry.linux.x86_32.so"
linux.x86_32.sentry_crash_backend_crashpad = "res://addons/sentry/bin/linux/x86_32/crashpad/libsentry.linux.x86_32.so"
linux.x86_32.sentry_crash_backend_native = "res://addons/sentry/bin/linux/x86_32/native/libsentry.linux.x86_32.so"
linux.arm64 = "res://addons/sentry/bin/linux/arm64/crashpad/libsentry.linux.arm64.so"
linux.arm64.sentry_crash_backend_crashpad = "res://addons/sentry/bin/linux/arm64/crashpad/libsentry.linux.arm64.so"
linux.arm64.sentry_crash_backend_native = "res://addons/sentry/bin/linux/arm64/native/libsentry.linux.arm64.so"

android.arm64 = "res://addons/sentry/bin/android/libsentry.android.arm64.so"
android.arm32 = "res://addons/sentry/bin/android/libsentry.android.arm32.so"
android.x86_64 = "res://addons/sentry/bin/android/libsentry.android.x86_64.so"
android.x86_32 = "res://addons/sentry/bin/android/libsentry.android.x86_32.so"

ios = "res://addons/sentry/bin/ios/libsentry.ios.xcframework"

web.wasm32 = "res://addons/sentry/bin/web/libsentry.web.wasm32.nothreads.wasm"
web.threads.wasm32 = "res://addons/sentry/bin/web/libsentry.web.wasm32.wasm"

[dependencies]

macos = {
	"res://addons/sentry/bin/macos/libSentry.dylib" : ""
}

ios = {
  "res://addons/sentry/bin/ios/Sentry.xcframework": "",
}
